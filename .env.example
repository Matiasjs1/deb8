# Server environment variables
# On Render you set these in the dashboard (or via render.yaml). For local dev,
# copy this file to server/.env and fill in the values.

NODE_ENV=production
PORT=4000

# MongoDB Atlas free tier (M0) connection string.
# Create it under Atlas -> Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/deb8db?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=<replace-with-a-long-random-string>

# Seconds per turn in "Por turnos" / moderated debates (optional, default 30).
TURN_DURATION_SECONDS=30

# Only needed for LOCAL dev (Vite on 5173 talking to the API on 4000).
# Ignored in production (NODE_ENV=production) because client + API share the origin.
CORS_ORIGIN=http://localhost:5173
